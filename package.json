{
  "name": "advientea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma migrate deploy && tsx prisma/seed-ingredients.ts && next build --turbopack",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:u": "vitest --project unit",
    "test:u:ui": "vitest --project unit --ui",
    "test:i": "vitest --project integration ",
    "test:i:ui": "vitest --project integration --ui",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "^16.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^10.76.2",
    "better-auth": "^1.7.11",
    "cloudinary": "^2.11.0",
    "daisyui": "^5.7.50",
    "fastest-levenshtein": "^1.0.16",
    "import-in-the-middle": "^2.0.6",
    "next": "16.4.2",
    "next-cloudinary": "^6.19.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "baseline-browser-mapping": "^2.11.30",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  },
  "browserslist": "> 1%",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  }
}
