# Committed on purpose: values for the test suite only (local Docker and CI).
# Real secrets never go here. Override locally with .env.test.local (gitignored).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tests"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="test-only-secret-not-used-anywhere-else"
# Pinned so a developer's DATABASE_URL_UNPOOLED in .env can never redirect the test migrations.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/tests"
