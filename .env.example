# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/advientea"
# Optional: direct (unpooled) connection for migrations; Neon provides it on Vercel.
# DATABASE_URL_UNPOOLED=""
# Vercel previews only: hostname of the production database. A preview refuses to run against it.
# PRODUCTION_DB_HOST=""

# BetterAuth
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (Email Service)
RESEND_API_KEY="re_your_resend_api_key_here"

# Cloudinary (Image Management)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Context7 MCP (Optional - for documentation)
CONTEXT7_API_KEY="your-context7-api-key"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="your-sentry-api-key"