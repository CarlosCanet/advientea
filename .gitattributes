# Store and check out every text file with LF, whatever the developer's core.autocrlf says.
# Prettier (endOfLine: lf) and .editorconfig agree with this, so no tool rewrites line endings.
* text=auto eol=lf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.mp3 binary
